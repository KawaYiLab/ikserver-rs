# 复制为 .env 后填写。.env 不入库。
#
# sqlx 编译期检查 SQL 与运行时都读 DATABASE_URL（远程开发库，向维护者索取）。
# 运行时其余配置统一用 IK_ 前缀（见 docs/dev-setup.md）。
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>

IK_ENV=dev
IK_HTTP__ADDR=127.0.0.1:8080
IK_HTTP__ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
IK_HTTP__TRUSTED_PROXY_HOPS=0
IK_SESSION__COOKIE_SECURE=false
# 32 字节以上的随机串（base64）。生产必须单独生成：openssl rand -base64 48
IK_SECRETS__CODE_HMAC_KEY=ZGV2LW9ubHktY29kZS1obWFjLWtleS1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=
IK_LOG__FORMAT=pretty
RUST_LOG=info,ik_server=debug,ik_auth=debug,ik_kernel=debug,sqlx=warn

# 入站考试（可选，以下为默认值）
# IK_EXAM__QUESTION_COUNT=100
# IK_EXAM__PASS_SCORE_PERCENT=60
# IK_EXAM__TIME_LIMIT_SECS=3600
# IK_EXAM__MAX_FAILS_BEFORE_COOLDOWN=3
# IK_EXAM__FAIL_COOLDOWN_SECS=1800
# IK_EXAM__REWARD_DENNY=50
# IK_EXAM__REWARD_EXP=50

# 热榜（可选，以下为默认值；启动时校验范围）
# IK_HOT__ENABLED=true
# IK_HOT__COUNT=4
# IK_HOT__FEED_SIZE=200
# IK_HOT__REFRESH_SECS=600
# IK_HOT__GRAVITY=1.2
# IK_HOT__RECENT_DAYS=7
# IK_HOT__CANDIDATES=1000
# IK_HOT__MAX_PER_AUTHOR=1
# 搜索（可选）。不设置 URL 时不连接 Meilisearch，搜索全部走数据库兜底。
# IK_SEARCH__URL=http://127.0.0.1:7700
# IK_SEARCH__API_KEY=<Meilisearch master key 或带写权限的 API key>
# IK_SEARCH__INDEX_PREFIX=          # 区分环境，例如 staging_
# IK_SEARCH__TIMEOUT_MS=3000
# IK_SEARCH__SWEEP_SECS=30
# IK_SEARCH__RECONCILE_HOURS=24
# 搜索引擎测试用例（crates/search/tests）连这个实例；不设置时跳过
# IK_TEST_MEILI_URL=http://127.0.0.1:7700
# IK_TEST_MEILI_KEY=<master key>
