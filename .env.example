# 复制为 .env 后填写。.env 不入库。
#
# sqlx 编译期检查 SQL 与运行时都读 DATABASE_URL（远程开发库，向维护者索取）。
# 运行时其余配置统一用 IK_ 前缀（见 docs/dev-setup.md）。
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database>

IK_ENV=dev
IK_HTTP__ADDR=127.0.0.1:8080
IK_HTTP__ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
IK_HTTP__TRUSTED_PROXY_HOPS=0
IK_SESSION__COOKIE_SECURE=false
# 32 字节以上的随机串（base64）。生产必须单独生成：openssl rand -base64 48
IK_SECRETS__CODE_HMAC_KEY=ZGV2LW9ubHktY29kZS1obWFjLWtleS1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=
# 米游社扫码登录的确定性会话密钥（base64，≥32 字节；生产与多实例必填，各实例相同）
IK_SECRETS__QR_SESSION_KEY=ZGV2LW9ubHktcXItc2Vzc2lvbi1rZXktZG8tbm90LXVzZS1pbi1wcm9k
IK_LOG__FORMAT=pretty
RUST_LOG=info,ik_server=debug,ik_auth=debug,ik_kernel=debug,sqlx=warn

# 入站考试（可选，以下为默认值）
# IK_EXAM__QUESTION_COUNT=100
# IK_EXAM__PASS_SCORE_PERCENT=60
# IK_EXAM__TIME_LIMIT_SECS=3600
# IK_EXAM__MAX_FAILS_BEFORE_COOLDOWN=3
# IK_EXAM__FAIL_COOLDOWN_SECS=1800
# IK_EXAM__REWARD_DENNY=50
# IK_EXAM__REWARD_EXP=50

# 热榜（可选，以下为默认值；启动时校验范围）
# IK_HOT__ENABLED=true
# IK_HOT__COUNT=4
# IK_HOT__FEED_SIZE=200
# IK_HOT__REFRESH_SECS=600
# IK_HOT__GRAVITY=1.2
# IK_HOT__RECENT_DAYS=7
# IK_HOT__CANDIDATES=1000
# IK_HOT__MAX_PER_AUTHOR=1
# 搜索（可选）。不设置 URL 时不连接 Meilisearch，搜索全部走数据库兜底。
# IK_SEARCH__URL=http://127.0.0.1:7700
# IK_SEARCH__API_KEY=<Meilisearch master key 或带写权限的 API key>
# IK_SEARCH__INDEX_PREFIX=          # 索引名前缀，例如 ik_；与旧站共用同一个 Meilisearch 时必须设，否则会撞上旧站的 comment 索引
# IK_SEARCH__TIMEOUT_MS=3000
# IK_SEARCH__SWEEP_SECS=30
# IK_SEARCH__RECONCILE_HOURS=24
# 搜索引擎测试用例（crates/search/tests）连这个实例；不设置时跳过
# IK_TEST_MEILI_URL=http://127.0.0.1:7700
# IK_TEST_MEILI_KEY=<master key>

# 对象存储与直传上传（可选）。不设置 BUCKET 时上传接口返回 503。
# IK_STORAGE__ENDPOINT=https://<account>.r2.cloudflarestorage.com
# IK_STORAGE__REGION=auto
# IK_STORAGE__BUCKET=
# IK_STORAGE__ACCESS_KEY=
# IK_STORAGE__SECRET_KEY=
# IK_STORAGE__PUBLIC_BASE_URL=https://im.tiwat.cn   # CDN；为空时用 {endpoint}/{bucket}
# IK_STORAGE__ROOT_PREFIX=
# IK_STORAGE__PUBLIC_READ_ACL=false                 # 七牛设为 true；R2 不支持 ACL
# IK_STORAGE__SIGN_EXPIRES_SECS=600
# IK_STORAGE__VERIFY_SLOTS=2
# IK_STORAGE__QUEUE_TIMEOUT_SECS=60
# IK_STORAGE__TASK_TIMEOUT_SECS=90
# IK_STORAGE__REQUEST_TIMEOUT_SECS=15
# IK_STORAGE__STAGING_TTL_HOURS=24                 # 没完成的上传保留多久后清理
# 媒体测试用例（crates/media/tests）连这个 S3 兼容服务；不设置时跳过
# IK_TEST_S3_URL=http://127.0.0.1:9000
# IK_TEST_S3_ACCESS_KEY=
# IK_TEST_S3_SECRET_KEY=

# ---------- 后台任务（graphile_worker） ----------
# IK_JOBS__RUN_WORKER=true      # false：本实例只入队不执行
# IK_JOBS__CONCURRENCY=4        # 同时执行的任务数（1–64）

# ---------- 全站默认限流（每分钟；读 = GET/HEAD） ----------
# IK_RATE_LIMIT__ENABLED=true
# IK_RATE_LIMIT__ANON_READ_PER_MIN=300
# IK_RATE_LIMIT__ANON_WRITE_PER_MIN=60
# IK_RATE_LIMIT__USER_READ_PER_MIN=600
# IK_RATE_LIMIT__USER_WRITE_PER_MIN=120

# ---------- 多实例 ----------
# 每个实例 IK_NODE_ID 不同，并配置相同的 IK_SECRETS__CODE_HMAC_KEY。
# IK_BUS__CLUSTER=false         # true：实时事件经 PostgreSQL LISTEN/NOTIFY 转给其他实例

# ---------- 米游社扫码登录 ----------
# IK_MIHOYO__ENABLED=true
# IK_MIHOYO__TIMEOUT_SECS=10
# IK_MIHOYO__PASSPORT_BASE_URL=https://passport-api.miyoushe.com
# IK_MIHOYO__TAKUMI_BASE_URL=https://api-takumi.mihoyo.com

# ---------- 举报与审核 ----------
# AI 助手：OpenAI 兼容的上游，按名字引用（模型的 provider 字段）。上游也可以在管理后台「AI 助手 → 提供方」里增删，
# 不必写在这里；同名时以这里为准。模型、角色卡、额度上限在管理后台维护（或 `ik-server ai import`）。
# IK_AI__PROVIDERS__DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
# IK_AI__PROVIDERS__DEEPSEEK__API_KEY=
# IK_AI__HOLD_TTL_SECS=900               # 额度预占存活时长
# IK_AI__REPLY_TIMEOUT_SECS=300          # 单条回复总预算
# IK_AI__FIRST_DELTA_TIMEOUT_SECS=90     # 首帧看门狗（0 关闭）
# IK_AI__MAX_HISTORY_MESSAGES=40         # 私信历史最多带多少条
# IK_AI__MAX_TOOL_ROUNDS=3               # 一次回复最多几轮工具调用
# IK_MODERATION__AUTO_HIDE_THRESHOLD=5   # 同一内容被这么多个不同的人举报（待处理）时自动隐藏

# ---------- 发信（验证码邮件） ----------
# dev_log：不发信，整封邮件（含验证码）写进日志，只能用于开发。正式环境用 dual：
# 国内邮箱（qq.com、163.com 等）走 SMTP，其余走 Brevo，主通道失败改走另一个；只配一个通道时全走它。
# IK_MAIL__PROVIDER=dev_log
# IK_MAIL__FALLBACK=true
# IK_MAIL__DOMESTIC_DOMAINS=["corp.cn"]        # 追加的国内域名（小写）
# IK_MAIL__SMTP__HOST=smtp.qiye.aliyun.com
# IK_MAIL__SMTP__PORT=465
# IK_MAIL__SMTP__TLS=implicit                 # implicit（465）或 starttls（587）
# IK_MAIL__SMTP__USERNAME=
# IK_MAIL__SMTP__PASSWORD=
# IK_MAIL__SMTP__FROM=绳网 <noreply@example.cn>
# IK_MAIL__SMTP__REPLY_TO=
# IK_MAIL__SMTP__TIMEOUT_SECS=15
# IK_MAIL__SMTP__POOL_SIZE=3
# IK_MAIL__BREVO__API_KEY=
# IK_MAIL__BREVO__API_URL=https://api.brevo.com/v3
# IK_MAIL__BREVO__FROM=绳网 <noreply@example.com>
# IK_MAIL__BREVO__REPLY_TO=
# IK_MAIL__BREVO__TIMEOUT_SECS=10
