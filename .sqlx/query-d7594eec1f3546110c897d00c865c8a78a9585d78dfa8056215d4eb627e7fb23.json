  "db_name": "PostgreSQL",
  "query": "SELECT f.id, f.object_key, f.mime, f.size_bytes, f.width, f.height, f.name, f.created_at\n         FROM media_files f\n         WHERE f.sha256 = $1\n           AND ($2::bigint IS NULL OR EXISTS (\n               SELECT 1 FROM media_uploaders u WHERE u.media_id = f.id AND u.user_id = $2))\n         ORDER BY f.id\n         LIMIT 1",
