  "query": "SELECT id, username, level, equipped_card_id FROM users\n          WHERE status = 'active' AND username ILIKE '%' || $2 || '%' ESCAPE '\\'\n          ORDER BY (lower(username) = lower($1)) DESC,\n                   (username ILIKE $2 || '%' ESCAPE '\\') DESC,\n                   username, id\n          LIMIT $3",
