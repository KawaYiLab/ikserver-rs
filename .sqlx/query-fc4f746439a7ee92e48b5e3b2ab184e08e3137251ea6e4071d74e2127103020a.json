  "query": "SELECT c.post_id, c.author_id AS user_id, min(c.created_at) AS \"first_at!\"\n           FROM comments c\n           WHERE c.created_at >= $1 AND c.created_at <= $2 AND c.hidden_at IS NULL\n           GROUP BY c.post_id, c.author_id",
