  "query": "SELECT pt.post_id, t.name, t.slug\n         FROM post_tags pt JOIN tags t ON t.id = pt.tag_id\n         WHERE pt.post_id = ANY($1) AND NOT t.is_blocked\n         ORDER BY pt.post_id, pt.position",
