  "query": "SELECT id, login_method, user_agent, ip, location, created_at, last_seen_at, expires_at\n         FROM sessions\n         WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > $2\n         ORDER BY last_seen_at DESC, id DESC\n         LIMIT 100",
