{
  "db_name": "PostgreSQL",
  "query": "SELECT g.id,g.app_id,g.display_name,g.card_slug,g.enabled,g.blocked,g.left_at,g.last_active_at,\n        COALESCE(u.guest_turns,0) AS \"turns!\",COALESCE(u.tokens,0) AS \"tokens!\",g.group_openid\n        FROM qq_groups g LEFT JOIN qq_group_usage u ON u.group_id=g.id AND u.day=$1\n        WHERE ($2::bigint IS NULL OR g.id=$2) ORDER BY g.last_active_at DESC,g.id DESC LIMIT $3 OFFSET $4",
