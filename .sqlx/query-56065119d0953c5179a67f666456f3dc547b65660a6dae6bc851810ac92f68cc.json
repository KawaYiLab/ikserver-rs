  "query": "SELECT target_type, target_id, reason, detail, status, resolution, snapshot, created_at\n         FROM reports\n         WHERE owner_user_id = $1 AND NOT COALESCE((snapshot ->> 'anonymous')::boolean, FALSE)\n         ORDER BY created_at DESC, id DESC\n         LIMIT $2",
