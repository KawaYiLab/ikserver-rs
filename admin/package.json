{
  "name": "ik-admin-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "绳网管理后台（Nuxt 4 SPA），部署在 /admin，调用同源的 /v1/admin/* 接口",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "gen:api": "openapi-typescript ./openapi.json -o app/types/api.d.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.48.0",
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion-v": "2.5.2",
    "nuxt": "4.5.2",
    "openapi-fetch": "0.17.0",
    "reka-ui": "2.10.5",
    "shadcn-nuxt": "2.8.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
