# Docker 部署的配置。./init.sh 会复制成 .env 并填好下面标着「自动生成」的值。
# 其余可选项见仓库根目录的 .env.example（同样的 IK_ 变量，写在这里即可）。

# ---------- 自动生成 ----------
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
IK_SECRETS__CODE_HMAC_KEY=
IK_SECRETS__QR_SESSION_KEY=

# ---------- 站点 ----------
IK_ENV=prod
# 论坛前台的地址
IK_SITE_URL=https://forum.example.com
# 前台页面的来源（CORS、CSRF、WebSocket 握手都看它）
IK_HTTP__ALLOWED_ORIGINS=["https://forum.example.com"]
# ik-server 前面有几层反向代理（宿主机上一层 Caddy / nginx 填 1）
IK_HTTP__TRUSTED_PROXY_HOPS=1
IK_SESSION__COOKIE_SECURE=true

# 只想在本机用 http://127.0.0.1:8080 试一下：改成下面两行，不用配发信（验证码打印在日志里）。
# IK_ENV=dev
# IK_SESSION__COOKIE_SECURE=false

# ---------- 发信（IK_ENV=prod 时必填：注册和找回密码的验证码） ----------
IK_MAIL__PROVIDER=dual
IK_MAIL__SMTP__HOST=
IK_MAIL__SMTP__PORT=465
IK_MAIL__SMTP__TLS=implicit
IK_MAIL__SMTP__USERNAME=
IK_MAIL__SMTP__PASSWORD=
IK_MAIL__SMTP__FROM=

# ---------- 可选：搜索（docker compose --profile search up -d 之后去掉下面两行的注释） ----------
# IK_SEARCH__URL=http://meilisearch:7700
# IK_SEARCH__API_KEY=

# ---------- 可选：图片上传（任意 S3 兼容存储） ----------
# IK_STORAGE__ENDPOINT=
# IK_STORAGE__REGION=auto
# IK_STORAGE__BUCKET=
# IK_STORAGE__ACCESS_KEY=
# IK_STORAGE__SECRET_KEY=
# IK_STORAGE__PUBLIC_BASE_URL=
