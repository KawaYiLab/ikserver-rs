# 生产环境配置模板。复制到服务器的 /etc/interknot/ik-server.env 后填写：
#   sudo install -m 0640 -o root -g interknot ik-server.env.example /etc/interknot/ik-server.env
# systemd 的 EnvironmentFile 格式：每行 KEY=value，值不要加引号。
# 可选项与默认值见仓库根目录的 .env.example。

IK_ENV=prod
IK_HTTP__ADDR=127.0.0.1:8080
# 只有本机 nginx 一层；nginx 前面还有 CDN 时设为 2（ADR 0002）
IK_HTTP__TRUSTED_PROXY_HOPS=1
# 不设 IK_HTTP__ALLOWED_ORIGINS：网页都同源，App 用 Bearer 令牌，正式环境不需要跨域白名单
IK_SESSION__COOKIE_SECURE=true
# 主站直接跨站调用接口（interk.net → ik.tiwat.cn，没有同源反代 /v1）时打开，并把主站写进
# IK_HTTP__ALLOWED_ORIGINS；同源部署（ADR 0002）保持关闭
# IK_SESSION__COOKIE_CROSS_SITE=true
IK_LOG__FORMAT=json
RUST_LOG=info,sqlx=warn

DATABASE_URL=postgres://interknot:<password>@127.0.0.1:5432/interknot

# 各自用 openssl rand -base64 48 生成；多实例时所有实例相同，一旦上线不要再换
IK_SECRETS__CODE_HMAC_KEY=
IK_SECRETS__QR_SESSION_KEY=

IK_SEARCH__URL=http://127.0.0.1:7700
IK_SEARCH__API_KEY=

# 与旧系统同一个桶与 CDN（文件不搬家，ADR 0003）
IK_STORAGE__ENDPOINT=
IK_STORAGE__REGION=auto
IK_STORAGE__BUCKET=
IK_STORAGE__ACCESS_KEY=
IK_STORAGE__SECRET_KEY=
IK_STORAGE__PUBLIC_BASE_URL=https://im.tiwat.cn

# 验证码邮件：国内邮箱走 SMTP（国内邮件服务商），其余走 Brevo，主通道失败改走另一个。
# 旧后端的变量对应：SMTP_HOST/PORT/USER/PASS/DEFAULT_FROM/DEFAULT_REPLYTO → IK_MAIL__SMTP__*，
# SMTP_SECURE=true → TLS=implicit（false → starttls），BREVO_API_KEY/FROM/REPLYTO → IK_MAIL__BREVO__*。
# 发件人写成 `绳网 <noreply@example.cn>`（不要加引号）。
IK_MAIL__PROVIDER=dual
IK_MAIL__SMTP__HOST=
IK_MAIL__SMTP__PORT=465
IK_MAIL__SMTP__TLS=implicit
IK_MAIL__SMTP__USERNAME=
IK_MAIL__SMTP__PASSWORD=
IK_MAIL__SMTP__FROM=
IK_MAIL__BREVO__API_KEY=
IK_MAIL__BREVO__FROM=

# AI 助手的模型供应商（人格与模型在切换后用 `sudo ik ai import` 配置）
# IK_AI__PROVIDERS__DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
# IK_AI__PROVIDERS__DEEPSEEK__API_KEY=

# 绝区零剧情库 MCP（POST /v1/story/mcp，给剧情总结 AI 用）。语料由管理员在本地用
# `python -m zzz_story upload` 上传到数据库，这里只配访问控制（见 deploy/README.md）。
# 两者都不设时接口拒绝所有请求。
# IK_STORY__ACCESS_KEY=      # openssl rand -hex 32；客户端带 Authorization: Bearer <它>
# IK_STORY__PUBLIC=false     # true：不要密钥，公开访问
