# 生产环境配置模板。复制到服务器的 /etc/interknot/ik-server.env 后填写：
#   sudo install -m 0640 -o root -g interknot deploy/ik-server.env.example /etc/interknot/ik-server.env
# systemd 的 EnvironmentFile 格式：每行 KEY=value，值不要加引号。
# 这里只列上线必填和常用的项，其余可选项与默认值见仓库根目录的 .env.example。

IK_ENV=prod
IK_LOG__FORMAT=json
RUST_LOG=info,sqlx=warn

DATABASE_URL=postgres://interknot:<password>@127.0.0.1:5432/interknot

# 论坛前台的地址（后台「在主站打开」、QQ 机器人的帖子链接按它拼）
IK_SITE_URL=https://forum.example.com

# ---------- 网络（见 deploy/README.md「反向代理」） ----------
# 只让反向代理连进来：监听本机
IK_HTTP__ADDR=127.0.0.1:8080
# 前面有几层会追加 X-Forwarded-For 的代理（一层 Caddy / nginx 填 1）
IK_HTTP__TRUSTED_PROXY_HOPS=1
# 前台页面的来源（CORS、CSRF、WebSocket 握手都看它）
IK_HTTP__ALLOWED_ORIGINS=["https://forum.example.com"]
IK_SESSION__COOKIE_SECURE=true
# 前台和接口不在同一个站点时（例如 forum.example.com 调 api.example.net）打开
IK_SESSION__COOKIE_CROSS_SITE=false

# ---------- 密钥 ----------
# 各自用 openssl rand -base64 48 生成；多实例时所有实例相同，上线后不要再换
IK_SECRETS__CODE_HMAC_KEY=
IK_SECRETS__QR_SESSION_KEY=

# ---------- 发信（注册和找回密码的验证码） ----------
# 只配 SMTP 时所有邮件都走它；同时配 Brevo 时国内邮箱走 SMTP，其余走 Brevo，失败时互为备份。
IK_MAIL__PROVIDER=dual
IK_MAIL__SMTP__HOST=
IK_MAIL__SMTP__PORT=465
IK_MAIL__SMTP__TLS=implicit
IK_MAIL__SMTP__USERNAME=
IK_MAIL__SMTP__PASSWORD=
# 发件人写成 `我的论坛 <noreply@example.com>`（不要加引号）
IK_MAIL__SMTP__FROM=

# ---------- 可选：搜索（不配时走数据库搜索） ----------
# IK_SEARCH__URL=http://127.0.0.1:7700
# IK_SEARCH__API_KEY=

# ---------- 可选：图片上传（不配时上传接口返回 503） ----------
# 任意 S3 兼容存储（Cloudflare R2、MinIO、七牛等）
# IK_STORAGE__ENDPOINT=
# IK_STORAGE__REGION=auto
# IK_STORAGE__BUCKET=
# IK_STORAGE__ACCESS_KEY=
# IK_STORAGE__SECRET_KEY=
# IK_STORAGE__PUBLIC_BASE_URL=https://cdn.example.com

# ---------- 可选：AI 助手（模型、角色卡在后台「AI 助手」里配置） ----------
# IK_AI__PROVIDERS__DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
# IK_AI__PROVIDERS__DEEPSEEK__API_KEY=

# ---------- 可选：米游社扫码登录（默认关闭，也可以在后台「系统设置」里打开） ----------
# IK_MIHOYO__ENABLED=false
